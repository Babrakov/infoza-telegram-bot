# Telegram bot credentials
BOT_TOKEN=your_bot_token_here
BOT_OWNER=owner_username_or_id

# API used by bot (if any)
API_KEY=your_api_key_here
API_URL=http://api.example.local

# Bot DB credentials (used by spring.datasource.bot.*)
BOT_DB_USERNAME=user
BOT_DB_PASSWORD=password

# Infoza DB credentials (used by spring.datasource.infoza.*)
INFOZA_DB_USERNAME=user
INFOZA_DB_PASSWORD=password

# Optional JVM options
JAVA_OPTS=

# Other optional vars
#SPRING_PROFILES_ACTIVE=prod
